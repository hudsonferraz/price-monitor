# Database (local Docker Postgres)
DATABASE_URL=postgresql://price_monitor:price_monitor@localhost:5433/price_monitor

# Redis (local Docker Redis)
REDIS_URL=redis://localhost:6379

# Auth.js / NextAuth (web app)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# Worker - Facebook Marketplace scraping
# Run `npm run facebook:login`, then use this persistent profile.
# Defaults to .facebook-profile at the repo root when unset.
FACEBOOK_BROWSER_PROFILE_DIR=.facebook-profile
PLAYWRIGHT_HEADLESS=false
# Where failed real polls save page.png/page.html/page.txt (newest 20 kept, never committed).
# Defaults to .debug/poll-failures at the repo root when unset.
# POLL_SNAPSHOT_DIR=.debug/poll-failures
# Demo / mock mode. `npm run demo` sets these for you; you only need them to mix
# demo pieces into a manual setup.
# MOCK_MARKETPLACE=true replaces Facebook with a deterministic simulated marketplace
# (no browser, no .facebook-profile access).
MOCK_MARKETPLACE=false
# Artificial delay per mock poll so poll status changes are visible (ms).
MOCK_MARKETPLACE_DELAY_MS=2500
# Fraction (0-1) of mock polls that fail with a simulated timeout. 0 = never.
MOCK_MARKETPLACE_FAILURE_RATE=0
# Web app: enables "Continue as demo user" sign-in and a 30s manual poll cooldown.
# Ignored in production builds.
DEMO_MODE=false

# Telegram deal notifications (optional, free). Worker only: the web app never needs the token.
# 1) In Telegram, talk to @BotFather, send /newbot, pick a name; it replies with a token.
# 2) Paste it here and restart the worker. Then click "Connect Telegram" on the dashboard.
TELEGRAM_BOT_TOKEN=
# Pause between messages to the same chat (Telegram allows ~1 per second).
# TELEGRAM_SEND_INTERVAL_MS=1100
# Base URL for links in messages (defaults to AUTH_URL, then http://localhost:3000).
# APP_BASE_URL=http://localhost:3000
