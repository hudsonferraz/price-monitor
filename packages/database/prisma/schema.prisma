generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketplaceSource {
  FACEBOOK
}

enum PollRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id                        String        @id @default(cuid())
  name                      String?
  email                     String        @unique
  emailVerified             DateTime?
  image                     String?
  preferredLocale             String        @default("pt-BR")
  accounts                  Account[]
  sessions                  Session[]
  savedSearches             SavedSearch[]
  alerts                    Alert[]
  telegramConnection        TelegramConnection?
  telegramLinkCodes         TelegramLinkCode[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model SavedSearch {
  id              String        @id @default(cuid())
  userId          String
  name            String
  keywords        String
  minPriceCents   Int?
  maxPriceCents   Int?
  pollIntervalMin Int           @default(30)
  listingLimit    Int           @default(24)
  isEnabled       Boolean       @default(true)
  lastAttemptedAt DateTime?
  lastSuccessfulPollAt DateTime?
  consecutiveFailures Int @default(0)
  notificationsEnabled Boolean @default(true)
  /// Words or phrases that keep a listing out of this search's alerts (case- and accent-insensitive).
  excludeKeywords String[] @default([])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts          Alert[]
  pollRuns        PollRun[]
  listingPrices   SavedSearchListingPrice[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([isEnabled, lastSuccessfulPollAt])
}

model Listing {
  id         String            @id @default(cuid())
  source     MarketplaceSource
  externalId String
  title      String
  priceCents Int?
  currency   String            @default("BRL")
  url        String
  imageUrl   String?
  location   String?
  alerts     Alert[]
  snapshots  PollSnapshotListing[]
  searchPrices SavedSearchListingPrice[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([source, externalId])
}

model Alert {
  id            String      @id @default(cuid())
  userId        String
  savedSearchId String
  listingId     String
  previousPriceCents Int?
  priceDroppedAt     DateTime?
  seenAt             DateTime?
  dismissedAt        DateTime?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  notifications AlertNotification[]
  createdAt     DateTime    @default(now())

  @@unique([savedSearchId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([savedSearchId, dismissedAt])
}

model PollSnapshotListing {
  id         String   @id @default(cuid())
  pollRunId  String
  listingId  String
  priceCents Int?
  pollRun    PollRun  @relation(fields: [pollRunId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([pollRunId, listingId])
  @@index([pollRunId])
}

model SavedSearchListingPrice {
  savedSearchId String
  listingId     String
  priceCents    Int?
  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  updatedAt     DateTime    @updatedAt

  @@id([savedSearchId, listingId])
  @@index([savedSearchId])
}

model PollRun {
  id            String        @id @default(cuid())
  savedSearchId String
  status        PollRunStatus @default(RUNNING)
  listingsFound Int           @default(0)
  newAlerts     Int           @default(0)
  excludedCount Int           @default(0)
  errorMessage  String?
  durationMs    Int?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  savedSearch   SavedSearch           @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  snapshots     PollSnapshotListing[]

  @@index([savedSearchId, startedAt(sort: Desc)])
}

enum WorkerHeartbeatStatus {
  ONLINE
  OFFLINE
}

model WorkerHeartbeat {
  id                     String                @id @default(cuid())
  workerId               String                @unique
  status                 WorkerHeartbeatStatus @default(ONLINE)
  hostname               String?
  pid                    Int?
  startedAt              DateTime
  lastSeenAt             DateTime @default(now())
  facebookSessionStatus  String?
  facebookSessionMode    String?
  facebookSessionPath    String?
  facebookSessionMessage String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([lastSeenAt(sort: Desc)])
}

enum NotificationMode {
  NEW_AND_DROPS
  DROPS_ONLY
}

enum NotificationStatus {
  SENT
  FAILED
  SUMMARIZED
  SKIPPED
}

/// Telegram link and notification settings for one user. chatId null = disconnected.
model TelegramConnection {
  id               String           @id @default(cuid())
  userId           String           @unique
  chatId           String?          @unique
  paused           Boolean          @default(false)
  mode             NotificationMode @default(NEW_AND_DROPS)
  minDropPercent   Int              @default(0)
  quietStartMinute Int?
  quietEndMinute   Int?
  timeZone         String           @default("America/Sao_Paulo")
  linkedAt         DateTime?
  testRequestedAt  DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

/// One-time code carried by the t.me deep link; expires after 15 minutes.
model TelegramLinkCode {
  code      String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Written by the worker (which holds the bot token) so the web app knows the bot is running.
model TelegramBotState {
  id          String   @id @default("default")
  botUsername String
  lastSeenAt  DateTime
  lastError   String?
  updatedAt   DateTime @updatedAt
}

/// One row per alert event (new match, or a drop at a given time): guarantees at most one message.
model AlertNotification {
  id        String             @id @default(cuid())
  alertId   String
  eventKey  String
  status    NotificationStatus
  reason    String?
  alert     Alert              @relation(fields: [alertId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([alertId, eventKey])
}
