{
  "name": "price-monitor",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "npm run build --workspace=@price-monitor/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint scripts vitest.config.ts --max-warnings=0 && turbo run lint",
    "typecheck": "turbo run typecheck",
    "spike:facebook": "npm run spike:facebook --workspace=@price-monitor/worker",
    "facebook:login": "npm run facebook:login --workspace=@price-monitor/worker",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres redis",
    "docker:ps": "docker compose ps",
    "local:up": "node scripts/local-up.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "node scripts/demo.mjs --seed-only",
    "db:generate": "npm run db:generate --workspace=@price-monitor/database",
    "db:push": "npm run db:push --workspace=@price-monitor/database",
    "worker:dev": "npm run dev --workspace=@price-monitor/worker",
    "postinstall": "npm run db:generate --workspace=@price-monitor/database"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.21",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.1.4"
  }
}
